# VHDL Style Guide Configuration
# https://vhdl-style-guide.readthedocs.io/
rule:
  global:
    indent_size: 4
  
  # Signal naming conventions
  signal_007:
    prefix: ['s_', '']
  
  # Port naming conventions  
  port_010:
    prefix:
      - 'i_'   # inputs
      - 'o_'   # outputs
      - 'io_'  # bidirectional
      - ''     # allow no prefix too

  # Architecture naming
  architecture_004:
    architecture_name: ['rtl', 'behavioral', 'structural', 'testbench']