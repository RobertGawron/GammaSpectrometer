@startuml
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50

title Gamma Spectrometer - Dual Channel Architecture

skinparam package {
    BackgroundColor<<analog>> #LightBlue
    BackgroundColor<<digital>> #LightYellow
    BackgroundColor<<timing>> #E8EEF5
}

[Radioactive Sample] as Sample

' =====================================================
' Data Acquisition Unit
' =====================================================
package "Data Acquisition Unit" <<analog>> {

    component "Scintillation Crystal\n(NaI(Tl))" as Crystal

    package "AFE" #CFE8FF {

        package "AFE Channel 1" #EAF4FF {
            component "SiPM\n(MICROFC-60035-SMT-TR1)" as SiPM_1
            component "Charge Amplifier\n(OPA690xDBV)" as CA_1
            component "ADC Driver\n(LTC6363)" as Driver_1
        }

        package "AFE Channel 2" #EAF4FF {
            component "SiPM\n(MICROFC-60035-SMT-TR1)" as SiPM_2
            component "Charge Amplifier\n(OPA690xDBV)" as CA_2
            component "ADC Driver\n(LTC6363)" as Driver_2
        }

        SiPM_1 -down[hidden]- CA_1
        CA_1 -down[hidden]- Driver_1

        SiPM_2 -down[hidden]- CA_2
        CA_2 -down[hidden]- Driver_2
    }

    package "SiPM Bias" #CFE8FF {
        component "30V DC-DC Boost\n(LT1930)" as Boost
        component "29V Bias Supply\n(TPS7A4901)" as Bias
        component "Temperature Sensing\n(Thermistor+MCP3221)" as TempSense
        component "SiPM Temperature Compensation DAC\n(MCP4725xxx-xCH)" as TempBias
        component "Overlight Protection" as Protection
    }
}

' =====================================================
' Clock Subsystem
' =====================================================
package "Clock Subsystem" <<timing>> {
    component "40 MHz LVDS Oscillator\n(511JCA40M0000BAG)" as OSC
    component "LVDS Fanout Buffer\n(SY75576LKY)" as FANOUT
    component "LVDS → CMOS Buffer\n(PI6C49CB01Q2WEX)" as CLKBUF
}

' =====================================================
' Data Processing Unit
' =====================================================
package "Data Processing Unit" <<digital>> {
    component "Dual ADC 12-bit 40 MSPS (AD9238)" as ADC
    component "SPI Flash\n(Bitstream Storage)\n(MX25L1606EM1I-12G)" as Flash
    component "FPGA\n(iCE40HX4K)" as FPGA
    component "UART to USB\nCommunication" as Comm

    ADC -right[hidden]- Flash
    FPGA -right[hidden]- Comm
}

actor "User\n(PC Software)" as User

' =====================================================
' Analog Signal Path (Dark Orange)
' =====================================================
Sample -down[#D35400,bold]-> Crystal

Crystal -down[#D35400,bold]-> SiPM_1 : <color:#D35400>photons</color>
SiPM_1 -down[#D35400,bold]-> CA_1 : <color:#D35400>Q(t)</color>
CA_1 -down[#D35400,bold]-> Driver_1 : <color:#D35400>V(t)</color>
Driver_1 -[#D35400,bold]-> ADC : <color:#D35400>differential pair CH1</color>

Crystal -down[#D35400,bold]-> SiPM_2 : <color:#D35400>photons</color>
SiPM_2 -down[#D35400,bold]-> CA_2 : <color:#D35400>Q(t)</color>
CA_2 -down[#D35400,bold]-> Driver_2 : <color:#D35400>V(t)</color>
Driver_2 -[#D35400,bold]-> ADC : <color:#D35400>differential pair CH2</color>

ADC -down[#D35400,bold]-> FPGA : <color:#D35400>12-bit samples @ 40 MSPS</color>

' =====================================================
' Digital Processing
' =====================================================
FPGA -down[#D35400,bold]-> Comm : <color:#D35400>spectrum data</color>
Comm -down[#D35400,bold]-> User : <color:#D35400>spectrum data</color>

Flash -left[#800080,dashed]---> FPGA : SPI

' =====================================================
' Clock Distribution (Dark Gray)
' =====================================================
"Clock Subsystem"-up[hidden]- "Data Processing Unit"
OSC -up[#444444,bold]-> FANOUT : LVDS 40 MHz
FANOUT -[#444444,bold]-> FPGA : LVDS 40 MHz
FANOUT -up[#444444,bold]-> CLKBUF : LVDS 40 MHz
CLKBUF -up[#444444,bold]-> ADC : CMOS 40 MHz

' =====================================================
' Bias & Protection
' =====================================================
Boost -left-> Bias
Bias -left-> "AFE"
Protection -down-> Bias : disable on fault

' =====================================================
' I2C Control (Purple)
' =====================================================
TempSense -down[#800080,dashed]-> FPGA : I2C
TempBias -[#800080,dashed]-> FPGA : I2C

' Compensation Voltage
TempBias -up-> Bias : compensation voltage

TempSense -up[hidden]- TempBias
@enduml