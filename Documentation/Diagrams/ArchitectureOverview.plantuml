@startuml
skinparam componentStyle rectangle
skinparam linetype ortho

title Gamma Spectrometer - System Architecture

skinparam package {
    BackgroundColor<<detector>> #LightGreen
    BackgroundColor<<analog>> #LightBlue
    BackgroundColor<<digital>> #LightYellow
}

[Radioactive Sample] as Sample

package "Detector Assembly" <<detector>> {
    component "Scintillation Crystal\n(NaI(Tl))" as Crystal
    component "Silicon Photomultiplier\n(MICROFC-60035-SMT-TR1)" as Photodiode
    component "29V DC Bias Voltage\n(LT1930A+TPS7A4901DGNR)" as Bias
}

package "Analog Signal Chain" <<analog>> {
    [Charge Preamplifier] as Preamp
    [Pulse Shaper] as Shaper
    [Peak Detector / Sample-and-Hold] as PeakDetect
}

package "Digital Processing" <<digital>> {
    [Microcontroller / ADC Board] as MCU
    [UART/USB Communication] as Comm
}

' Signal flow
Sample ---> Crystal : gamma rays
Crystal --> Photodiode : photons
Photodiode ---> Preamp : current pulse
Preamp --> Shaper : voltage pulse
Shaper --> PeakDetect : shaped pulse
PeakDetect ---> MCU : peak amplitude
MCU --> Comm : spectrum data

' Bias connection
Bias --> Photodiode
@enduml